{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@aquabot/shared/contracts": [
        "./libs/aquabot/shared/contracts/src/index.ts"
      ],
      "@org/utils/pagination": ["./libs/shared/pagination/src/index.ts"],
      "@org/server/core": ["./libs/server/core/src/index.ts"],
      "@org/server/exceptions": ["./libs/server/exceptions/src/index.ts"],
      "@org/utils/codes": ["./libs/shared/codes/src/index.ts"],
      "@org/server/common": ["./libs/server/common/src/index.ts"],
      "@org/utils/resources": ["./libs/shared/resources/src/index.ts"],
      "@aquabot/server/errors": ["./libs/aquabot/server/errors/src/index.ts"],
      "@org/server/cache": ["./libs/server/cache/src/index.ts"],
      "@org/database/mongodb": ["./libs/server/database/mongodb/src/index.ts"],
      "@org/server/auth": ["./libs/server/auth/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
